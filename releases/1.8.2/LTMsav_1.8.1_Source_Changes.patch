+let noFunds=planRecurring([{...rule,amount:9000000}],[],accounts,categories,'2026-10-24');assert.equal(noFunds.created,0);assert.equal(noFunds.errors.length,1);assert.equal(noFunds.rules[0].nextDate,rule.nextDate);

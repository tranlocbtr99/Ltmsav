index 0000000..dba1d93
--- /dev/null
+++ b/scripts/verify_apk.py
@@ -0,0 +1,27 @@
+"""Reject APK layouts Android 11+ refuses, even when zipalign reports success."""
+import struct
+import sys
+import zipfile
+from pathlib import Path
+
+def verify(path):
+    data = Path(path).read_bytes()
+    with zipfile.ZipFile(path) as archive:
+        resource = archive.getinfo('resources.arsc')
+        if resource.compress_type != zipfile.ZIP_STORED:
+            raise ValueError('resources.arsc must be uncompressed for targetSdk >= 30')
+        for entry in archive.infolist():
+            if entry.compress_type != zipfile.ZIP_STORED:
+                continue
+            header = entry.header_offset
+            name_length, extra_length = struct.unpack_from('<HH', data, header + 26)
+            offset = header + 30 + name_length + extra_length
+            if offset % 4:
+                raise ValueError(f'{entry.filename}: uncompressed payload is not 4-byte aligned')
+        bad = archive.testzip()
+        if bad:
+            raise ValueError('ZIP integrity error: ' + bad)
+    print('PASS: resources.arsc uncompressed, stored entries aligned, ZIP integrity valid')
+
+if __name__ == '__main__':
+    verify(sys.argv[1])

+const accounts:Account[]=[{id:'cash',name:'Tiền mặt',type:'cash',balance:5000000,currency:'VND',iconName:'Banknote',color:'#10b981'},{id:'bank',name:'Ngân hàng',type:'bank',balance:2000000,currency:'VND',iconName:'Landmark',color:'#007aff'},{id:'savings',name:'Tiết kiệm',type:'savings',balance:1000000,currency:'VND',iconName:'PiggyBank',color:'#a855f7'}];
+const categories:Category[]=[{id:'food',name:'Ăn uống',type:'expense',iconName:'Utensils',color:'#f59e0b'},{id:'transport',name:'Di chuyển',type:'expense',iconName:'Car',color:'#007aff'},{id:'bills',name:'Hóa đơn & Tiện ích',type:'expense',iconName:'File',color:'#007aff'},{id:'salary',name:'Lương',type:'income',iconName:'Briefcase',color:'#10b981'},{id:'other',name:'Thu nhập khác',type:'income',iconName:'Coins',color:'#a855f7'}];

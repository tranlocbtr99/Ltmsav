+const parse=(text:string)=>parseFinancialText(text,accounts,categories,'2026-10-24');
+assert.equal(parse('Ăn sáng 35k tiền mặt hôm qua').commands?.[0].date,'2026-10-23');
+let transfer=parse('Chuyển 1tr5 từ ngân hàng sang tiết kiệm').commands![0];assert.equal(transfer.account,'Ngân hàng');assert.equal(transfer.account_to,'Tiết kiệm');assert.equal(transfer.amount,1500000);assert.deepEqual(validateAiCommand(transfer,accounts,categories),[]);
+assert.equal(parse('Chuyển từ tiết kiệm sang ngân hàng 500k').commands![0].account,'Tiết kiệm');
+let batch=parse('Ăn sáng 35k tiền mặt\nĐổ xăng 70k ngân hàng');assert.equal(batch.commands?.length,2);assert.equal(batch.commands?.[1].date,'2026-10-24');assert.deepEqual(batch.commands?.map(c=>c.category),['Ăn uống','Di chuyển']);
+assert.equal(parse('Ăn sáng bằng tiền mặt').commands![0].amount,0,'must not invent 50k');
+assert.equal(parse('Nhận lương 15tr ngân hàng').commands![0].kind,'income');
+assert.equal(parse('Chưa trả tiền nhà 2tr').commands?.length,0);
+assert.ok(validateAiCommand(parse('Ăn sáng 35k').commands![0],accounts,categories).includes('Chọn tài khoản nguồn.'));
+assert.equal(parse('TK 1234567890 -50.000 VND mua cà phê ngân hàng\nSố dư 12.000.000 VND').commands![0].amount,50000);
+assert.equal(parse('Cà phê 30k\nBánh 20k\nTổng thanh toán: 50k tiền mặt').commands![0].amount,50000);
+assert.equal(parse('Ăn sáng 35k tiền mặt ngày 31/02/2026').clarification_question?.includes('Ngày không hợp lệ'),true);
+assert.equal(validateAiCommand({...transfer,account_to:'Ngân hàng'},accounts,categories).length>0,true);
+assert.equal(parse('Ăn sáng 20 USD tiền mặt').commands![0].currency,'OTHER');
+const monthly={startDate:'2026-01-31',frequency:'monthly' as const,interval:1};assert.equal(nextOccurrence(monthly,'2026-01-31'),'2026-02-28');assert.equal(nextOccurrence(monthly,'2026-02-28'),'2026-03-31');
+const yearly={startDate:'2024-02-29',frequency:'yearly' as const,interval:1};assert.equal(nextOccurrence(yearly,'2027-02-28'),'2028-02-29');
+const rule:RecurringRule={id:'rent',name:'Tiền ăn',type:'expense',amount:50000,accountId:'cash',categoryId:'food',startDate:'2026-10-22',nextDate:'2026-10-22',frequency:'daily',interval:1,active:true,createdAt:'2026-10-22T00:00:00Z'};
+const original=JSON.stringify(accounts);let result=planRecurring([rule],[],accounts,categories,'2026-10-24');assert.equal(result.created,3);assert.equal(result.accounts[0].balance,4850000);assert.equal(result.rules[0].nextDate,'2026-10-25');assert.equal(JSON.stringify(accounts),original,'pure planner must not mutate original state');
+let again=planRecurring(result.rules,result.transactions,result.accounts,categories,'2026-10-24');assert.equal(again.created,0);assert.deepEqual(again.accounts,result.accounts);

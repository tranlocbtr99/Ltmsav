@@ -0,0 +1,29 @@
+import { Capacitor, registerPlugin } from '@capacitor/core';
+
+interface DocumentSaveBridge {
+  save(options: { filename: string; content: string }): Promise<{ cancelled: boolean; uri?: string }>;
+}
+const DocumentSave = registerPlugin<DocumentSaveBridge>('DocumentSave');
+export async function saveJsonBackup(content: string, filename: string): Promise<'saved'|'cancelled'> {
+  if (Capacitor.isNativePlatform()) {
+    const result = await DocumentSave.save({ content, filename });
+    return result.cancelled ? 'cancelled' : 'saved';
+  }
+  const picker = (window as any).showSaveFilePicker;
+  if (typeof picker === 'function') {
+    try {
+      const handle = await picker.call(window, { suggestedName: filename, types: [{ description: 'LTMsav JSON', accept: { 'application/json': ['.json'] } }] });
+      const writable = await handle.createWritable();
+      try { await writable.write(content); await writable.close(); }
+      catch (error) { try { await writable.abort(); } catch {} throw error; }
+      return 'saved';
+    } catch (error) { if ((error as Error).name === 'AbortError') return 'cancelled'; throw error; }
+  }
+  // Never silently download to a default folder: ask for a destination via the system share sheet.
+  const file = new File([content], filename, { type: 'application/json' });
+  if (navigator.canShare?.({ files: [file] }) && navigator.share) {
+    try { await navigator.share({ files: [file], title: 'LTMsav Backup' }); return 'saved'; }
+    catch (error) { if ((error as Error).name === 'AbortError') return 'cancelled'; throw error; }
+  }
+  throw new Error('Trình duyệt này không hỗ trợ chọn nơi lưu. Hãy dùng app Android hoặc trình duyệt hỗ trợ hộp thoại lưu tệp.');
+}

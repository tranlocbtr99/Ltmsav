+++ b/mobile/custom_android/DocumentSavePlugin.java
@@ -0,0 +1,59 @@
+package com.ltmsav.app;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.net.Uri;
+import androidx.activity.result.ActivityResult;
+import com.getcapacitor.JSObject;
+import com.getcapacitor.Plugin;
+import com.getcapacitor.PluginCall;
+import com.getcapacitor.PluginMethod;
+import com.getcapacitor.annotation.ActivityCallback;
+import com.getcapacitor.annotation.CapacitorPlugin;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+
+/** User-selected JSON destination through Android's Storage Access Framework. */
+@CapacitorPlugin(name = "DocumentSave")
+public class DocumentSavePlugin extends Plugin {
+    private volatile boolean saving;
+
+    @PluginMethod
+    public void save(PluginCall call) {
+        if (saving) { call.reject("Một hộp thoại lưu đang mở."); return; }
+        String content = call.getString("content");
+        String filename = call.getString("filename", "LTMsav_Backup.json");
+        if (content == null || !filename.endsWith(".json")) {
+            call.reject("Nội dung hoặc tên tệp sao lưu không hợp lệ."); return;
+        }
+        Intent intent = new Intent("android.intent.action.CREATE_DOCUMENT");
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType("application/json");
+        intent.putExtra(Intent.EXTRA_TITLE, filename.replaceAll("[/\\\\]", "_"));
+        saving = true;
+        try { startActivityForResult(call, intent, "onDocumentCreated"); }
+        catch (Exception error) { saving = false; call.reject("Không mở được hộp thoại chọn nơi lưu.", error); }
+    }
+
+    @ActivityCallback
+    private void onDocumentCreated(PluginCall call, ActivityResult result) {
+        if (call == null) { saving = false; return; }
+        Intent data = result.getData();
+        if (result.getResultCode() != Activity.RESULT_OK || data == null || data.getData() == null) {
+            saving = false;
+            JSObject response = new JSObject(); response.put("cancelled", true); call.resolve(response); return;
+        }
+        final Uri uri = data.getData();
+        new Thread(new Runnable() {
+            @Override public void run() {
+        // The picker returns only the exact document explicitly chosen by the user.
+        try (OutputStream stream = getContext().getContentResolver().openOutputStream(uri, "wt")) {
+            if (stream == null) throw new java.io.IOException("Không mở được tệp.");
+            stream.write(call.getString("content", "").getBytes(StandardCharsets.UTF_8));
+            stream.flush();
+        } catch (Exception error) { saving = false; call.reject("Không lưu được tệp JSON. Dữ liệu trong ứng dụng vẫn được giữ nguyên.", error); return; }
+        JSObject response = new JSObject(); response.put("cancelled", false); response.put("uri", uri.toString()); saving = false; call.resolve(response);
+            }
+        }, "LTMsav-Backup").start();
+    }
+}

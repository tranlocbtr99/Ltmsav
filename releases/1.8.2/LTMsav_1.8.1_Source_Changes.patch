+export const localDate = (date = new Date()): string => `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
+export function validDate(value: string): boolean {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  const [y,m,d] = value.split('-').map(Number);
+  const test = new Date(y,m-1,d,12);
+  return y >= 1900 && y <= 2200 && localDate(test) === value;
+}
+export function addDays(value: string, days: number): string {
+  const [y,m,d] = value.split('-').map(Number);return localDate(new Date(y,m-1,d+days,12));
+}
diff --git a/src/services/recurring.ts b/src/services/recurring.ts
new file mode 100644
index 0000000..2421ead
--- /dev/null
+++ b/src/services/recurring.ts
@@ -0,0 +1,55 @@
+import { Account, Category, RecurringRule, Transaction } from '../types';
+import { localDate, validDate, addDays } from './dates';
+
+export function nextOccurrence(rule:Pick<RecurringRule,'startDate'|'frequency'|'interval'>,after:string):string {
+ if(!validDate(rule.startDate)||!validDate(after)||!Number.isInteger(rule.interval)||rule.interval<1||rule.interval>366)throw new Error('Lịch không hợp lệ.');
+ if(rule.frequency==='daily'||rule.frequency==='weekly')return addDays(after,rule.interval*(rule.frequency==='weekly'?7:1));
+ const [ay,am,ad]=rule.startDate.split('-').map(Number);const [y,m]=after.split('-').map(Number);
+ const year=rule.frequency==='yearly'?y+rule.interval:y;
+ const month=rule.frequency==='yearly'?am-1:m-1+rule.interval;
+ // Clamp to last day but retain the anchor day, so Jan 31 -> Feb 28 -> Mar 31.
+ const maxDay=new Date(year,month+1,0,12).getDate();
+ return localDate(new Date(year,month,Math.min(ad,maxDay),12));
+}
+export function validateRule(rule:Omit<RecurringRule,'id'|'createdAt'>,accounts:Account[],categories:Category[]):void {
+ if(!rule.name?.trim())throw new Error('Nhập tên giao dịch định kỳ.');
+ if(!['expense','income','transfer'].includes(rule.type))throw new Error('Loại giao dịch không hợp lệ.');
+ if(!Number.isSafeInteger(rule.amount)||rule.amount<=0)throw new Error('Số tiền phải là số nguyên dương.');
+ if(!accounts.some(a=>a.id===rule.accountId))throw new Error('Chọn tài khoản nguồn hợp lệ.');
+ if(rule.type==='transfer') {if(!accounts.some(a=>a.id===rule.targetAccountId)||rule.accountId===rule.targetAccountId)throw new Error('Chọn tài khoản nhận khác nguồn.');}
+ else if(!categories.some(c=>c.id===rule.categoryId&&c.type===(rule.type==='income'?'income':'expense')))throw new Error('Chọn danh mục hợp lệ.');
+ if(!validDate(rule.startDate)||!validDate(rule.nextDate)||rule.nextDate<rule.startDate)throw new Error('Ngày bắt đầu hoặc kỳ kế tiếp không hợp lệ.');
+ if(rule.endDate&&(!validDate(rule.endDate)||rule.endDate<rule.startDate))throw new Error('Ngày kết thúc phải từ ngày bắt đầu trở đi.');
+ if(!['daily','weekly','monthly','yearly'].includes(rule.frequency)||!Number.isInteger(rule.interval)||rule.interval<1||rule.interval>366)throw new Error('Chu kỳ không hợp lệ.');
+}
+export interface RecurringPlan { rules:RecurringRule[]; transactions:Transaction[]; accounts:Account[]; created:number; errors:{id:string,message:string}[] }
+export function planRecurring(rules:RecurringRule[],transactions:Transaction[],accounts:Account[],categories:Category[],today=localDate(),allowNegative=false):RecurringPlan {
+ const result:RecurringPlan={rules:structuredClone(rules),transactions:structuredClone(transactions),accounts:structuredClone(accounts),created:0,errors:[]};
+ const ids=new Set(transactions.map(t=>t.id));
+ for(const rule of result.rules){
+  if(!rule.active)continue;
+  try {
+   validateRule(rule,result.accounts,categories);
+   let processed=0;
+   while(rule.nextDate<=today&&(!rule.endDate||rule.nextDate<=rule.endDate)){
+    if(processed++>=366){result.errors.push({id:rule.id,message:'Còn nhiều kỳ quá hạn. Mở lại ứng dụng để xử lý tiếp.'});break;}
+    const id=`rec_${rule.id}_${rule.nextDate}`;
+    if(!ids.has(id)){
+     const source=result.accounts.find(a=>a.id===rule.accountId)!;
+     if(!allowNegative&&rule.type!=='income'&&source.balance<rule.amount)throw new Error('Số dư nguồn không đủ. Bổ sung số dư hoặc sửa lịch để ghi kỳ này.');
+     if(!Number.isSafeInteger(source.balance)||!Number.isSafeInteger(source.balance+(rule.type==='income'?rule.amount:-rule.amount)))throw new Error('Số dư vượt giới hạn tính toán an toàn.');
+     const target=rule.type==='transfer'?result.accounts.find(a=>a.id===rule.targetAccountId):undefined;
+     if(target&&!Number.isSafeInteger(target.balance+rule.amount))throw new Error('Số dư đích vượt giới hạn tính toán an toàn.');
+     const tx:Transaction={id,type:rule.type,amount:rule.amount,accountId:rule.accountId,targetAccountId:rule.type==='transfer'?rule.targetAccountId:undefined,categoryId:rule.categoryId,date:rule.nextDate,description:rule.name,note:[rule.note,'Giao dịch định kỳ'].filter(Boolean).join(' • '),createdAt:new Date().toISOString()};
+     source.balance+=rule.type==='income'?rule.amount:-rule.amount;
+     if(target)target.balance+=rule.amount;
+     result.transactions.unshift(tx);ids.add(id);result.created++;
+    }
+    rule.nextDate=nextOccurrence(rule,rule.nextDate);
+   }
+   if(rule.endDate&&rule.nextDate>rule.endDate)rule.active=false;
+  }catch(error){result.errors.push({id:rule.id,message:error instanceof Error?error.message:'Không thể ghi giao dịch định kỳ.'});}
+ }
+ result.transactions.sort((a,b)=>b.date.localeCompare(a.date)||b.createdAt.localeCompare(a.createdAt));
+ return result;
+}
